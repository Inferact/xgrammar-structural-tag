{
  "auto_no_tools": {
    "type": "structural_tag",
    "format": {
      "type": "any_text",
      "excludes": [
        "<think>",
        "</think>"
      ]
    }
  },
  "auto_one_tool": {
    "type": "structural_tag",
    "format": {
      "type": "triggered_tags",
      "triggers": [
        "<tool_call>"
      ],
      "tags": [
        {
          "begin": "<tool_call>\n{\"name\": \"search\", \"arguments\": ",
          "content": {
            "type": "json_schema",
            "json_schema": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "style": "json"
          },
          "end": "}\n</tool_call>"
        }
      ],
      "at_least_one": false,
      "stop_after_first": false,
      "excludes": [
        "<think>",
        "</think>"
      ]
    }
  },
  "required_two_tools": {
    "type": "structural_tag",
    "format": {
      "type": "tags_with_separator",
      "tags": [
        {
          "begin": "<tool_call>\n{\"name\": \"search\", \"arguments\": ",
          "content": {
            "type": "json_schema",
            "json_schema": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "style": "json"
          },
          "end": "}\n</tool_call>"
        },
        {
          "begin": "<tool_call>\n{\"name\": \"alt\", \"arguments\": ",
          "content": {
            "type": "json_schema",
            "json_schema": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "style": "json"
          },
          "end": "}\n</tool_call>"
        }
      ],
      "separator": "\n",
      "at_least_one": true,
      "stop_after_first": false
    }
  },
  "forced_search": {
    "type": "structural_tag",
    "format": {
      "type": "tag",
      "begin": "<tool_call>\n{\"name\": \"search\", \"arguments\": ",
      "content": {
        "type": "json_schema",
        "json_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "style": "json"
      },
      "end": "}\n</tool_call>"
    }
  },
