{
  "auto_no_tools": {
    "type": "structural_tag",
    "format": {
      "type": "any_text",
      "excludes": [
        "<|START_THINKING|>",
        "<|END_THINKING|>"
      ],
      "max_tokens": null,
      "max_chars": null
    }
  },
  "auto_one_tool": {
    "type": "structural_tag",
    "format": {
      "type": "triggered_tags",
      "triggers": [
        "<cofl:tool_calls>"
      ],
      "tags": [
        {
          "type": "tag",
          "begin": "<cofl:tool_calls>",
          "content": {
            "type": "tags_with_separator",
            "tags": [
              {
                "type": "tag",
                "begin": "<cofl:tool_call id=\"",
                "content": {
                  "type": "sequence",
                  "elements": [
                    {
                      "type": "regex",
                      "pattern": "\\d+"
                    },
                    {
                      "type": "const_string",
                      "value": "\" name=\"search\">"
                    },
                    {
                      "type": "json_schema",
                      "json_schema": {
                        "type": "object",
                        "properties": {
                          "q": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "q"
                        ]
                      },
                      "style": "cohere_xml",
                      "any_order": false,
                      "max_whitespace_cnt": null
                    }
                  ]
                },
                "end": "</cofl:tool_call>"
              }
            ],
            "separator": "",
            "at_least_one": true,
            "stop_after_first": false
          },
          "end": "</cofl:tool_calls>"
        }
      ],
      "at_least_one": false,
      "stop_after_first": false,
      "excludes": [
        "<|START_THINKING|>",
        "<|END_THINKING|>"
      ]
    }
  },
