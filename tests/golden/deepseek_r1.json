                    "type": "object",
                    "properties": {
                      "q": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "q"
                    ]
                  },
                  "style": "json"
                },
                "end": "\n```<｜tool▁call▁end｜>"
              }
            ],
            "separator": "\n",
            "at_least_one": true,
            "stop_after_first": false
          },
          "end": "<｜tool▁calls▁end｜>"
        }
      ],
      "at_least_one": false,
      "stop_after_first": false,
