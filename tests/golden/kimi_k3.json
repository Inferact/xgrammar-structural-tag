{
  "auto_no_tools": {
    "type": "structural_tag",
    "format": {
      "type": "sequence",
      "elements": [
        {
          "type": "tag",
          "begin": "",
          "content": {
            "type": "any_text",
            "excludes": [
              "<|open|>",
              "<|close|>"
            ],
            "max_tokens": null,
            "max_chars": null
          },
          "end": "<|close|>response<|sep|>"
        },
        {
          "type": "const_string",
          "value": "<|close|>message<|sep|>"
        }
      ]
    }
  },
  "auto_one_tool": {
    "type": "structural_tag",
    "format": {
      "type": "sequence",
      "elements": [
        {
          "type": "tag",
          "begin": "",
          "content": {
            "type": "any_text",
            "excludes": [
              "<|open|>",
              "<|close|>"
            ],
            "max_tokens": null,
            "max_chars": null
          },
          "end": "<|close|>response<|sep|>"
        },
        {
          "type": "optional",
          "content": {
            "type": "tag",
            "begin": "<|open|>tools<|sep|>",
            "content": {
              "type": "tags_with_separator",
              "tags": [
                {
                  "type": "tag",
                  "begin": "<|open|>call tool=\"search\" index=\"",
                  "content": {
                    "type": "sequence",
                    "elements": [
                      {
                        "type": "regex",
                        "pattern": "\\d+"
                      },
                      {
                        "type": "const_string",
                        "value": "\"<|sep|>"
                      },
                      {
                        "type": "json_schema",
                        "json_schema": {
                          "type": "object",
                          "properties": {
                            "q": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "q"
                          ]
                        },
                        "style": "kimi_k3_xml",
                        "any_order": false,
                        "max_whitespace_cnt": null
                      }
                    ]
                  },
                  "end": "<|close|>call<|sep|>"
                }
              ],
              "separator": "",
              "at_least_one": true,
              "stop_after_first": false
            },
            "end": "<|close|>tools<|sep|>"
          }
        },
        {
          "type": "const_string",
          "value": "<|close|>message<|sep|>"
        }
      ]
    }
  },
