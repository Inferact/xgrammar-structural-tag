{
  "auto_no_tools": {
    "type": "structural_tag",
    "format": {
      "type": "any_text",
      "excludes": [
        "<think>",
        "</think>"
      ]
    }
  },
  "auto_one_tool": {
    "type": "structural_tag",
    "format": {
      "type": "triggered_tags",
      "triggers": [
        "<tool_call>"
      ],
      "tags": [
        {
          "begin": "<tool_call>search",
          "content": {
            "type": "json_schema",
            "json_schema": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "style": "glm_xml"
          },
          "end": "</tool_call>"
        }
      ],
      "at_least_one": false,
      "stop_after_first": false,
      "excludes": [
        "<think>",
        "</think>"
      ]
    }
  },
