  "auto_no_tools": {
    "type": "structural_tag",
    "format": {
      "type": "any_text",
      "excludes": [
        "<|channel>",
        "<channel|>",
        "<|tool_call>"
      ],
      "max_tokens": null,
      "max_chars": null
    }
  },
  "auto_one_tool": {
    "type": "structural_tag",
    "format": {
      "type": "triggered_tags",
      "triggers": [
        "<|tool_call>"
      ],
      "tags": [
        {
          "type": "tag",
          "begin": "<|tool_call>call:search",
          "content": {
            "type": "json_schema",
            "json_schema": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "style": "gemma",
            "any_order": false,
            "max_whitespace_cnt": null,
            "excludes": [
              "<|channel>",
              "<channel|>",
              "<|tool_call>",
              "<tool_call|>"
            ]
          },
          "end": "<tool_call|>"
        }
      ],
      "at_least_one": false,
      "stop_after_first": false,
      "excludes": [
        "<|channel>",
        "<channel|>"
      ]
    }
  },
