{
  "auto_no_tools": {
    "type": "structural_tag",
    "format": {
      "type": "any_text",
      "excludes": [
        "<think>",
        "</think>"
      ]
    }
  },
  "auto_one_tool": {
    "type": "structural_tag",
    "format": {
      "type": "triggered_tags",
      "triggers": [
        "{\"name\": "
      ],
      "tags": [
        {
          "begin": "{\"name\": \"search\", \"parameters\": ",
          "content": {
            "type": "json_schema",
            "json_schema": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "style": "json",
            "any_order": false,
            "max_whitespace_cnt": null
          },
          "end": "}"
        }
      ],
      "at_least_one": false,
      "stop_after_first": false,
      "excludes": [
        "<think>",
        "</think>"
      ]
    }
  },
