{
  "auto_no_tools": {
    "type": "structural_tag",
    "format": {
      "type": "any_text",
      "excludes": [],
      "max_tokens": null,
      "max_chars": null
    }
  },
  "auto_one_tool": {
    "type": "structural_tag",
    "format": {
      "type": "triggered_tags",
      "triggers": [
        "<tool_calls>"
      ],
      "tags": [
        {
          "type": "tag",
          "begin": "<tool_calls>\n",
          "content": {
            "type": "tags_with_separator",
            "tags": [
              {
                "type": "tag",
                "begin": "<tool_call>search<tool_sep>",
                "content": {
                  "type": "json_schema",
                  "json_schema": {
                    "type": "object",
                    "properties": {
                      "q": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "q"
                    ]
                  },
                  "style": "glm_xml",
                  "any_order": false,
                  "max_whitespace_cnt": null
                },
                "end": "</tool_call>"
              }
            ],
            "separator": "\n",
            "at_least_one": true,
            "stop_after_first": false
          },
          "end": "</tool_calls>"
        }
      ],
      "at_least_one": false,
      "stop_after_first": false,
      "excludes": []
    }
  },
